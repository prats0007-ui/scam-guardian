# Copy this file to .env and fill in your keys. Never commit .env!

# --- Model provider ---
# While waiting for Nebius approval: use build.nvidia.com (free prototyping).
# Once approved: switch these two lines to your Token Factory base URL and key.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your-key-here

# Exact model IDs, copied from the provider's model catalog.
# During development, set BOTH to a Nemotron Nano model to save credits.
# For real testing and the demo, set MODEL_JUDGE to Nemotron 3 Ultra.
MODEL_FAST=your-nemotron-nano-model-id
MODEL_JUDGE=your-nemotron-nano-model-id

# --- Tools ---
TAVILY_API_KEY=your-tavily-key
TELEGRAM_BOT_TOKEN=your-botfather-token
# Optional: leave blank to skip Safe Browsing checks
SAFE_BROWSING_API_KEY=
